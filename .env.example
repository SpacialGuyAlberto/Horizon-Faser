# ==============================================================================
# CONFIGURACIÓN DE RED Y ENTORNO - UNITY HORIZON-FASER (PLANTILLA)
# ==============================================================================
# Copia este archivo como .env y edita las IPs según tu red Wi-Fi o Hotspot:

# Dirección IP de la Laptop donde corre Docker y el backend Quarkbau
LAPTOP_IP=192.168.1.100
SERVER_PORT=8080
SERVER_URL=http://192.168.1.100:8080

# Dirección IP de las Gafas (Meta Quest 3 / Casco AR)
GLASSES_IP=192.168.1.101
UDP_LISTEN_PORT=8000
